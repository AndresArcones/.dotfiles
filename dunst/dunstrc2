[global]
    monitor = 0
    follow = mouse
    width = 300
    offset = 10x40
    origin = top-right
    transparency = 10
    frame_color = "#aaaaaa"
    separator_color = auto
    font = Monospace 10
    format = "<b>%s</b>\n%b"
    sort = yes
    alignment = left
    show_age_threshold = 60
    idle_threshold = 120
    word_wrap = yes
    ignore_newline = no
    show_indicators = yes
    enable_markup = yes
    mouse_left_click = close_current
    mouse_right_click = context
    mouse_middle_click = do_action

[urgency_low]
    timeout = 4
    background = "#222222"
    foreground = "#888888"
    frame_color = "#444444"

[urgency_normal]
    timeout = 8
    background = "#285577"
    foreground = "#ffffff"
    frame_color = "#285577"

[urgency_critical]
    timeout = 0
    background = "#900000"
    foreground = "#ffffff"
    frame_color = "#ff0000"
